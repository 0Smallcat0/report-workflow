{
  "profile": "academic",
  "voice_register": "formal",
  "acceptable_sentence_length": {
    "min": 10,
    "max": 35,
    "target": 20
  },
  "hedging_rules": {
    "allow_hedging": true,
    "required_for_weak_evidence": true,
    "allowed_hedges": [
      "may", "might", "could", "possibly", "suggests",
      "indicates", "appears", "potentially", "perhaps"
    ],
    "forbidden_superlatives": [
      "proves", "demonstrates conclusively", "establishes definitively"
    ]
  },
  "passive_voice": {
    "allowed": true,
    "max_percentage_per_paragraph": 30
  },
  "impersonal_constructions": {
    "allowed": true,
    "flag_list": []
  },
  "contractions": {
    "allowed": false
  },
  "colloquialisms": {
    "allowed": false
  },
  "rhetorical_questions": {
    "allowed": false
  },
  "emoji": {
    "allowed": false
  },
  "jargon": {
    "tolerance": "moderate",
    "technical_terms_allowed": true
  }
}
