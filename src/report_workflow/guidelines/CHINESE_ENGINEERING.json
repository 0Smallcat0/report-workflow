{
  "guideline_id": "chinese_engineering_report",
  "name": "Chinese Engineering Lab Report",
  "name_zh": "中文工程實驗報告",
  "description": "Quality checklist for Chinese-language engineering laboratory reports. Focuses on section coverage, units, formulas, calculation traceability, figure/table references, and report-tone cleanup.",
  "applicable_profiles": ["engineering_lab_report"],
  "language": "zh-TW",

  "required_sections": [
    {"heading": "實驗目的", "role": "introduction", "required": true},
    {"heading": "實驗原理", "role": "methods", "required": true},
    {"heading": "實驗步驟", "role": "methods", "required": true},
    {"heading": "結果與討論", "role": "results", "required": true},
    {"heading": "問題與討論", "role": "discussion", "required": false},
    {"heading": "結論與心得", "role": "reflection", "required": true},
    {"heading": "參考資料", "role": "references", "required": true}
  ],

  "typography": {
    "body_east_asia_font": "DFKai-SB",
    "body_east_asia_font_display": "標楷體",
    "body_latin_font": "Times New Roman",
    "allowed_east_asia_fonts": ["標楷體", "DFKai-SB", "BiauKai"],
    "allowed_latin_fonts": ["Times New Roman"],
    "body_font_size_pt": 12
  },

  "tone_rules": {
    "forbidden_body_terms": [
      "NotebookLM",
      "workflow",
      "process",
      "tool",
      "this report uses your provided",
      "I inferred",
      "if you want",
      "agent"
    ],
    "subjective_terms": [
      "非常成功",
      "十分準確",
      "顯著改善",
      "明顯優於",
      "完美",
      "極佳"
    ],
    "first_person_terms": [
      "我",
      "我們",
      "本人",
      "筆者"
    ],
    "first_person_policy": "warn",
    "subjective_policy": "warn"
  },

  "heading_detection": {
    "section_heading_regex": "^(?:[一二三四五六七八九十]+[、.]|[0-9]+[.)、]|[IVX]+[.])",
    "discussion_keywords": ["問題與討論", "討論"]
  },

  "extraction_heuristics": {
    "formula_hint_regex": "(=|\\b(?:Re|Cd|C_D|CL|C_L|Cp|C_p)\\b|Δ|Σ|sqrt|\\^|/)",
    "question_regex": "^\\d+[.)、]",
    "constant_keywords": [
      "電壓",
      "電流",
      "壓力",
      "流量",
      "溫度",
      "頻率",
      "面積",
      "速度",
      "密度",
      "黏度",
      "Pa",
      "mm",
      "cm",
      "m/s",
      "kg",
      "gf",
      "Hz"
    ]
  },

  "items": [
    {
      "item_id": "CE01",
      "check": "All required section headings are present",
      "severity": "must",
      "automated": true
    },
    {
      "item_id": "CE02",
      "check": "Body text uses 標楷體 (DFKai-SB) for Chinese and Times New Roman for Latin characters",
      "severity": "should",
      "automated": false
    },
    {
      "item_id": "CE03",
      "check": "Body font size is 12pt",
      "severity": "should",
      "automated": false
    },
    {
      "item_id": "CE04",
      "check": "No forbidden body terms (workflow jargon, agent metadata) appear in the report",
      "severity": "must",
      "automated": true
    },
    {
      "item_id": "CE05",
      "check": "Subjective or exaggerated terms are flagged for review",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE06",
      "check": "First-person pronouns follow the declared policy",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE07",
      "check": "Discussion section contains numbered questions with answers when questions are present in the source handout",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE08",
      "check": "Results section contains at least one figure or table reference",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE09",
      "check": "All formula variables are defined with units",
      "severity": "should",
      "automated": false
    },
    {
      "item_id": "CE10",
      "check": "References section contains at least one entry",
      "severity": "must",
      "automated": true
    }
  ]
}
