{
  "guideline_id": "chinese_engineering_report",
  "name": "Chinese Engineering Lab Report",
  "name_zh": "中文工程實驗報告",
  "description": "Quality checklist for Chinese-language engineering laboratory reports, ported from report-from-notebooklm constants and QA rules.",
  "applicable_families": ["academic_report"],
  "applicable_details": ["chinese_engineering", "lab_report"],
  "language": "zh-TW",

  "required_sections": [
    {"heading": "實驗簡介", "role": "introduction", "required": true},
    {"heading": "實驗結果(圖、表)與分析", "role": "results", "required": true},
    {"heading": "問題與討論", "role": "discussion", "required": true},
    {"heading": "心得與建議", "role": "reflection", "required": true},
    {"heading": "參考文獻", "role": "references", "required": true}
  ],

  "typography": {
    "body_east_asia_font": "DFKai-SB",
    "body_east_asia_font_display": "標楷體",
    "body_latin_font": "Times New Roman",
    "allowed_east_asia_fonts": ["標楷體", "DFKai-SB", "BiauKai"],
    "allowed_latin_fonts": ["Times New Roman"],
    "body_font_size_pt": 12
  },

  "tone_rules": {
    "forbidden_body_terms": [
      "NotebookLM",
      "workflow",
      "process",
      "tool",
      "this report uses your provided",
      "I inferred",
      "if you want",
      "agent"
    ],
    "subjective_terms": [
      "非常完美",
      "非常成功",
      "極佳",
      "優秀",
      "相當不錯",
      "很棒"
    ],
    "first_person_terms": [
      "我們",
      "我",
      "本組認為",
      "我認為"
    ],
    "first_person_policy": "warn",
    "subjective_policy": "warn"
  },

  "heading_detection": {
    "section_heading_regex": "^(?:[一二三四五六七八九十]+[、.]|[IVX]+[.])",
    "discussion_keywords": ["問題與討論", "討論"]
  },

  "extraction_heuristics": {
    "formula_hint_regex": "(=|\\b(?:Re|Cd|C_D|CL|C_L|Cp|C_p)\\b|ρ|ν|μ|sqrt|√)",
    "question_regex": "^\\d+[.、)]",
    "constant_keywords": [
      "直徑", "弦長", "厚度", "密度", "黏度", "流速",
      "壓力", "攻角", "面積", "雷諾數",
      "Pa", "mm", "cm", "m/s", "kg", "gf", "Hz"
    ]
  },

  "items": [
    {
      "item_id": "CE01",
      "check": "All required section headings are present",
      "severity": "must",
      "automated": true
    },
    {
      "item_id": "CE02",
      "check": "Body text uses 標楷體 (DFKai-SB) for Chinese and Times New Roman for Latin characters",
      "severity": "should",
      "automated": false
    },
    {
      "item_id": "CE03",
      "check": "Body font size is 12pt",
      "severity": "should",
      "automated": false
    },
    {
      "item_id": "CE04",
      "check": "No forbidden body terms (workflow jargon, agent metadata) appear in the report",
      "severity": "must",
      "automated": true
    },
    {
      "item_id": "CE05",
      "check": "Subjective/exaggerated terms are flagged for review",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE06",
      "check": "First-person pronouns follow the declared policy (warn or block)",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE07",
      "check": "Discussion section contains numbered questions with answers",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE08",
      "check": "Results section contains at least one figure or table reference",
      "severity": "should",
      "automated": true
    },
    {
      "item_id": "CE09",
      "check": "All formula variables are defined with units",
      "severity": "should",
      "automated": false
    },
    {
      "item_id": "CE10",
      "check": "References section contains at least one entry",
      "severity": "must",
      "automated": true
    }
  ]
}
