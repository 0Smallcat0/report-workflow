{
  "derivations": [
    {
      "id": "unbranded_share",
      "source": "amazon_products.csv",
      "op": "share",
      "rows": "brand=",
      "of": "*",
      "label": "未標示品牌的商品列佔比",
      "expect": 61.9485
    },
    {
      "id": "no_price_share",
      "source": "amazon_products.csv",
      "op": "share",
      "rows": "price=",
      "of": "*",
      "label": "未顯示價格的商品列佔比"
    },
    {
      "id": "dji_photo_share",
      "source": "amazon_classified.csv",
      "op": "share",
      "rows": "category=攝影 & brand=DJI",
      "of": "category=攝影",
      "label": "DJI 佔攝影類商品列比重"
    },
    {
      "id": "photo_branded_share",
      "source": "amazon_classified.csv",
      "op": "share",
      "rows": "category=攝影 & brand!=",
      "of": "category=攝影",
      "label": "攝影類中有標示品牌的商品列比重"
    },
    {
      "id": "reviewed_asins",
      "source": "amazon_reviews.csv",
      "op": "distinct",
      "column": "asin",
      "label": "評論資料涵蓋的相異商品數",
      "expect": 63
    },
    {
      "id": "photo_brand_hhi",
      "source": "amazon_classified.csv",
      "op": "hhi",
      "column": "brand",
      "rows": "category=攝影",
      "label": "攝影類品牌 HHI"
    },
    {
      "id": "brand_cr5",
      "source": "amazon_products.csv",
      "op": "top_share",
      "column": "brand",
      "k": 5,
      "label": "品牌前五大集中度 CR5"
    },
    {
      "id": "photo_mid_count",
      "source": "amazon_classified.csv",
      "op": "count",
      "rows": "category=攝影 & price>=100 & price<200",
      "label": "攝影類售價 100–200 美元的商品列數",
      "expect": 39
    },
    {
      "id": "nondrone_share",
      "source": "amazon_classified.csv",
      "op": "share",
      "rows": "category=非無人機商品",
      "of": "*",
      "label": "搜尋結果中非無人機商品佔比"
    },
    {
      "id": "agri_no_review",
      "source": "amazon_classified.csv",
      "op": "share",
      "rows": "category=植保 & review_count=",
      "of": "category=植保",
      "label": "植保類完全沒有評論數的商品列比重"
    },
    {
      "id": "heavy_listing_count",
      "source": "amazon_products.csv",
      "op": "count",
      "rows": "price>=1500",
      "label": "售價 1500 美元以上的商品列數",
      "expect": 44
    },
    {
      "id": "price_band_structure",
      "source": "amazon_products.csv",
      "label": "價格帶結構與評價表現",
      "group_by": {
        "column": "price",
        "buckets": [
          0,
          50,
          100,
          200,
          500,
          1500
        ],
        "label": "價格帶 (USD)"
      },
      "measures": [
        {
          "op": "count",
          "label": "商品數"
        },
        {
          "op": "share",
          "label": "佔全樣本"
        },
        {
          "op": "mean",
          "column": "rating",
          "label": "平均星等"
        },
        {
          "op": "share",
          "rows": "rating<4",
          "label": "低於 4 星比率"
        },
        {
          "op": "median",
          "column": "review_count",
          "label": "評論數中位數"
        }
      ]
    },
    {
      "id": "price_band_satisfaction",
      "source": [
        "amazon_reviews.csv",
        "amazon_products.csv"
      ],
      "join": {
        "on": "asin",
        "how": "inner"
      },
      "label": "各價格帶的實際買家評分",
      "group_by": {
        "column": "price",
        "buckets": [
          0,
          50,
          100,
          200,
          500,
          1500
        ],
        "label": "價格帶 (USD)"
      },
      "measures": [
        {
          "op": "count",
          "label": "評論則數"
        },
        {
          "op": "distinct",
          "column": "asin",
          "label": "涵蓋商品數"
        },
        {
          "op": "mean",
          "column": "review_rating",
          "label": "平均評分"
        },
        {
          "op": "share",
          "rows": "review_rating<=2",
          "label": "1–2 星比率"
        }
      ]
    },
    {
      "id": "category_satisfaction",
      "source": [
        "amazon_reviews.csv",
        "amazon_classified.csv"
      ],
      "join": {
        "on": "asin",
        "how": "inner"
      },
      "label": "各品類的實際買家評分",
      "group_by": {
        "column": "category",
        "label": "品類"
      },
      "measures": [
        {
          "op": "count",
          "label": "評論則數"
        },
        {
          "op": "distinct",
          "column": "asin",
          "label": "涵蓋商品數"
        },
        {
          "op": "mean",
          "column": "review_rating",
          "label": "平均評分"
        },
        {
          "op": "share",
          "rows": "review_rating<=2",
          "label": "1–2 星比率"
        }
      ]
    },
    {
      "id": "pain_theme_by_star",
      "source": "amazon_reviews.csv",
      "label": "各星等評論提及的問題主題比率",
      "group_by": {
        "column": "review_rating",
        "buckets": [
          1,
          2,
          3,
          4,
          5
        ],
        "label": "評分區間（星）"
      },
      "measures": [
        {
          "op": "count",
          "label": "評論則數"
        },
        {
          "op": "share",
          "rows": "review_body~connect",
          "label": "提及連線配對"
        },
        {
          "op": "share",
          "rows": "review_body~crash",
          "label": "提及墜機"
        },
        {
          "op": "share",
          "rows": "review_body~broke",
          "label": "提及零件損壞"
        },
        {
          "op": "share",
          "rows": "review_body~return",
          "label": "提及退貨"
        },
        {
          "op": "share",
          "rows": "review_body~batter",
          "label": "提及電池續航"
        }
      ]
    },
    {
      "id": "photo_price_band",
      "source": "amazon_classified.csv",
      "rows": "category=攝影",
      "label": "攝影類無人機的價格帶貨架結構",
      "group_by": {
        "column": "price",
        "buckets": [
          0,
          50,
          100,
          200,
          500,
          1500
        ],
        "label": "價格帶 (USD)"
      },
      "measures": [
        {
          "op": "count",
          "label": "商品數"
        },
        {
          "op": "share",
          "label": "佔攝影類"
        },
        {
          "op": "median",
          "column": "review_count",
          "label": "評論數中位數"
        },
        {
          "op": "count",
          "column": "sales",
          "label": "有近月銷量標示"
        }
      ]
    },
    {
      "id": "beginner_share",
      "source": "amazon_reviews.csv",
      "op": "share",
      "rows": "review_body~beginner",
      "of": "*",
      "label": "評論內文提及 beginner（新手）的比率"
    },
    {
      "id": "easyfly_share",
      "source": "amazon_reviews.csv",
      "op": "share",
      "rows": "review_body~easy to fly",
      "of": "*",
      "label": "評論內文提及 easy to fly（好上手）的比率"
    },
    {
      "id": "dji_median_price",
      "source": "amazon_products.csv",
      "op": "median",
      "column": "price",
      "rows": "brand=DJI",
      "label": "DJI 商品列價格中位數"
    },
    {
      "id": "dji_under200_share",
      "source": "amazon_products.csv",
      "op": "share",
      "rows": "brand=DJI & price<200",
      "of": "brand=DJI",
      "label": "DJI 商品列中售價低於 200 美元的比重"
    },
    {
      "id": "mid_band_brands",
      "source": "amazon_products.csv",
      "rows": "price>=100 & price<200",
      "label": "100–200 美元價格帶的品牌與評價",
      "group_by": {
        "column": "brand",
        "label": "品牌",
        "top": 6
      },
      "measures": [
        {
          "op": "count",
          "label": "商品數"
        },
        {
          "op": "mean",
          "column": "rating",
          "label": "平均星等"
        },
        {
          "op": "median",
          "column": "price",
          "label": "價格中位數"
        },
        {
          "op": "median",
          "column": "review_count",
          "label": "評論數中位數"
        }
      ]
    },
    {
      "id": "component_share",
      "source": "amazon_classified.csv",
      "op": "share",
      "rows": "category!=攝影 & category!=植保 & category!=非無人機商品 & category!=消費級/其他 & category!=多用途 & category!=消防投彈",
      "of": "*",
      "label": "零組件（無人機馬達與配件／零件）合計佔比"
    }
  ]
}