# ============================================================
# Report Workflow — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values you need.
# The workflow auto-loads .env from the project root on startup.
#
# Values set here are OVERRIDDEN by real environment variables
# and by parameters passed directly to start_report_task().
# ============================================================

# ---- Core (these are usually already installed) ----
# PANDOC_PATH=            # Custom path to pandoc executable (auto-detected if on PATH)
# MMDC_PATH=              # Custom path to mmdc executable (auto-detected if on PATH)

# ---- Web Research Backends (enable_research feature) ----
# Set at least ONE of these to enable automatic claim verification.
# Priority order: Tavily → Serper → SerpAPI → BrowserMCP → ManualAgent (no-op)
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
# BROWSER_MCP_SEARCH_COMMAND=   # Shell command template for browser-based search

# ---- NotebookLM Integration (enable_notebook_sync feature) ----
# NOTEBOOKLM_STORAGE_PATH=      # Path to auth storage state file
# NOTEBOOKLM_NOTEBOOK_ID=       # Default notebook ID to sync with
